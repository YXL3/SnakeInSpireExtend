<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SnakeInSpireExtend</AssemblyName>
    <RootNamespace>SnakeInSpireExtend</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Temporary compatibility define for source that still contains version-gated blocks.
         Remove this after those blocks are collapsed to the current game API. -->
    <DefineConstants>$(DefineConstants);STS2_AT_LEAST_0_111_0</DefineConstants>
  </PropertyGroup>

  <!-- The obsolete loader sources are not part of the main assembly build. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);SnakeInSpireExtend.Loader\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DllPath)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDllPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Keep generated package and Godot intermediate sources out of the compile globs. -->
  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />

    <Compile Remove=".godot\mono\temp\obj\**" />
    <None Remove=".godot\mono\temp\obj\**" />
    <Content Remove=".godot\mono\temp\obj\**" />
    <EmbeddedResource Remove=".godot\mono\temp\obj\**" />
  </ItemGroup>

  <!-- RitsuLib.References.props resolves the API-specific RitsuLib assembly set. -->
  <Import Project="$(RitsuLibDir)\RitsuLib.References.props" />

  <!-- Stage the single mod package and export its PCK after the main build. -->
  <Import Project="$(MSBuildProjectDirectory)\build\SnakeInSpireExtend.Pack.targets" />
</Project>

