<Project>
  <PropertyGroup>
    <!-- Slay the Spire 2 install used for the current reference set. -->
    <Sts2Dir>D:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>

    <!-- Installed RitsuLib bundle. -->
    <RitsuLibDir>D:\SteamLibrary\steamapps\workshop\content\2868840\3747602295</RitsuLibDir>

    <!-- Godot executable used for the mod PCK export. -->
    <GodotExe>D:\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>

    <!-- Game assembly references. -->
    <Sts2DllPath Condition="'$(Sts2DllPath)' == ''">$(Sts2DataDir)\sts2.dll</Sts2DllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == ''">$(Sts2DataDir)\0Harmony.dll</HarmonyDllPath>

    <!-- RitsuLib ships versioned reference sets; select the one matching sts2.dll. -->
    <RitsuLibReferenceTarget Condition="'$(RitsuLibReferenceTarget)' == ''">0.113.0</RitsuLibReferenceTarget>
  </PropertyGroup>
</Project>
