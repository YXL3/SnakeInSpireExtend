<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SnakeInSpireExtend.Loader</AssemblyName>
    <RootNamespace>SnakeInSpireExtend.Loader</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Sts2ApiCompat Condition="'$(Sts2ApiCompat)' == ''">0.107.1</Sts2ApiCompat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SnakeVariantWorkDir)' != ''">
    <OutputPath>$(SnakeVariantWorkDir)\loader\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(SnakeVariantWorkDir)\loader\obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Sts2DllPath Condition="'$(Sts2ApiCompat)' == '0.107.1'">$(Sts2_0_107_1_Sts2Dll)</Sts2DllPath>
    <Sts2DllPath Condition="'$(Sts2ApiCompat)' != '0.107.1'">$(Sts2_0_111_0_Dir)\sts2.dll</Sts2DllPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DllPath)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDllPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
